---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getReleaseSha } from '../lib/release';
import { readdirSync } from 'node:fs';

const ogCards = new Set(
  readdirSync('assets/images/og')
    .filter((file) => file.endsWith('.jpg'))
    .map((file) => file.replace(/\.jpg$/, '')),
);

interface Props {
  title: string;
  description: string;
  canonical: string;
  active?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  author?: string;
  visualMaster?: string;
  mainClass?: string;
  styles?: string[];
  inlineStyle?: string;
  robots?: string;
  structuredData?: unknown[];
}

const {
  title,
  description,
  canonical,
  active = '',
  type = 'website',
  published,
  updated,
  author = 'The Workspace Pro Editorial Team',
  visualMaster,
  mainClass,
  styles = [],
  inlineStyle,
  robots,
  structuredData = [],
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);

// Per-route social card, drawn by scripts/generate-og-cards.mjs. Cards are
// committed, so a page falls back to the shared default only when one is
// genuinely missing rather than silently shipping a broken image URL.
// Legacy root pages carry an absolute canonical lifted from their source HTML,
// while Astro pages pass a relative one — slug off the parsed pathname so both agree.
const ogPath = canonicalUrl.pathname.replace(/\.html$/, '');
const ogSlug = ogPath === '/' ? 'home' : ogPath.replace(/^\//, '').replace(/\/+$/, '').replace(/\//g, '-');
const ogImageUrl = new URL(
  ogCards.has(ogSlug) ? `/assets/images/og/${ogSlug}.jpg` : '/assets/images/og-default.jpg',
  Astro.site,
).href;

const releaseSha = getReleaseSha();
const assetUrl = (path: string) => `${path}?v=${encodeURIComponent(releaseSha)}`;
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: published?.toISOString(),
      dateModified: updated?.toISOString(),
      author: { '@type': 'Organization', name: author },
      publisher: { '@type': 'Organization', name: 'The Workspace Pro' },
      mainEntityOfPage: canonicalUrl.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonicalUrl.href,
    };
const schemas = [...new Map(
  [schema, ...structuredData].map((entry) => [JSON.stringify(entry), entry]),
).values()];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="twp-release" content={releaseSha} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="The Workspace Pro" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/assets/images/favicon.svg" />
    <script is:inline>
      (function(){try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
    </script>
    <link rel="stylesheet" href={assetUrl('/assets/css/fonts.css')} />
    <link rel="stylesheet" href={assetUrl('/assets/css/style.css')} />
    <link rel="stylesheet" href={assetUrl('/assets/css/premium-studio.css')} />
    <link rel="stylesheet" href={assetUrl('/assets/css/worksheet.css')} />
    <link rel="stylesheet" href={assetUrl('/assets/css/editorial-v4.css')} />
    {styles.map((href) => <link rel="stylesheet" href={assetUrl(href)} />)}
    {inlineStyle && <style set:html={inlineStyle} />}
    {schemas.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body class="ps-shell editorial-shell" data-visual-master={visualMaster}>
    <SiteHeader active={active} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline src={assetUrl('/assets/js/analytics.js')} defer></script>
    <script is:inline src={assetUrl('/assets/js/site.js')} defer></script>
    <script is:inline src={assetUrl('/assets/js/perf-lite.js')} defer></script>
    <slot name="scripts" />
  </body>
</html>
